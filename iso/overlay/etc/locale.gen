# Локали, собираемые в live-образе ByteguruOS.
# Файл попадает в /etc/locale.gen через config/includes.chroot (overlay) и
# обрабатывается locale-gen в хуке 0100-byteguru-localization.chroot.
#
# ru_RU.UTF-8 — язык по умолчанию (владелец проекта работает в ru),
# en_US.UTF-8 — для отладки, баг-репортов upstream и CI-логов: сообщения тулзов
# удобнее вставлять в апстрим на английском.
#
# Все прочие локали НЕ включаем: образ должен оставаться маленьким, а
# пользователь доустановит нужное через locales после установки.
ru_RU.UTF-8 UTF-8
en_US.UTF-8 UTF-8
