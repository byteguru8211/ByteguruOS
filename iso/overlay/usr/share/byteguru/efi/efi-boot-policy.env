# ByteguruOS — политика EFI-загрузки: единый источник истины для
# byteguru-boot-repair и byteguru-boot-status.
#
# Файл — обычный набор присваиваний KEY="VALUE" (его source'ят оба скрипта,
# если он читаемый). Если файла нет, скрипты используют те же значения по
# умолчанию, поэтому отсутствие файла не делает ремонт загрузчика невозможным.
#
# ПОЧЕМУ ОТДЕЛЬНЫЙ ФАЙЛ, А НЕ хардкод в скриптах: имя метки и путь загрузчика
# обязаны совпадать в момент создания записи (repair) и в диагностике (status).
# Два разных места — это классический источник «status говорит ОК, а грузиться
# не хочет».

# Метка записи в NVRAM (то, что видит пользователь в меню прошивки).
BYTEGURU_EFI_LABEL="ByteguruOS"

# Кандидаты на ESP в порядке предпочтения (пути без ведущего обратного слэша,
# разделители — прямой слэш; repair сам преобразует в EFI-нотацию).
#   EFI/byteguru/* — наша директория (grub-install --bootloader-id=byteguru)
#   EFI/debian/*   — как кладёт grub-efi-amd64 по умолчанию (и live-build)
#   EFI/boot/*     — removable/fallback-путь прошивки
BYTEGURU_EFI_LOADERS="EFI/byteguru/grubx64.efi EFI/byteguru/bootx64.efi EFI/debian/grubx64.efi EFI/boot/bootx64.efi"

# ЗАЩИЩЕННЫЕ ЗАПИСИ: подстроки меток/путей чужих загрузчиков, которые
# инструменты ByteguruOS НЕ имеют права ни удалять, ни переставлять.
# Windows Boot Manager и системные записи прошивки (xxxx-наследие Dell/HP и
# прочее) остаются как есть — политика dual boot первоклассна.
BYTEGURU_EFI_PROTECTED="Microsoft Windows Boot Manager bootmgfw.efi fallback Firmware"

# Не трогать BootOrder, если после создания записи наша позиция всё равно
# не первая: значение в секундах, сколько раз перепроверить efibootmgr.
BYTEGURU_EFI_VERIFY_RETRIES=2
