#!/bin/bash
# Автоматическая установка из live-сессии — только по флагу ядра.
#
# Зачем: «установщик работает» и «образ ставится на диск и с диска
# загружается» — разные утверждения. Проверить второе руками на каждом
# изменении никто не будет, значит оно развалится молча. Этот скрипт — то,
# что делает прогон в QEMU настоящим end-to-end тестом установки.
#
# Включается он явно, потому что иначе любой человек, загрузившийся с этого
# ISO, получит переустановленную машину:
#
#   byteguru.autoinstall            — ставить на первый подходящий диск
#   byteguru.autoinstall byteguru.target_disk=/dev/sda   — на конкретный
#
# Ни один из вариантов не срабатывает без флага, а live-образ флага не
# добавляет.
#
# Результат — строки BYTEGURU-INSTALL-OK / BYTEGURU-INSTALL-FAIL на консоли
# (сервис пишет StandardOutput=journal+console), их же читает тест.

set -uo pipefail

say() {
	printf '%s\n' "$1"
	printf '%s\n' "$1" > /dev/console 2>/dev/null || true
}

CFG_TARGET=""
CFG_PROFILE="kiosk"
CFG_USER="guru"
CFG_PASSWORD="byteguru"
CFG_HOSTNAME="byteguru-vm"

# Способ 2: файл-ответ на fat-разделе. Нужен потому, что при загрузке через
# OVMF командную строку ядру передать нечем (нет -kernel/-append), а
# headless-прогон установки именно так и стартует.
find_answer() {
	local dev point
	for dev in $(lsblk -n -p -o NAME,FSTYPE | awk '$2 ~ /fat|vfat/ {print $1}'); do
		point="$(mktemp -d /tmp/byteguru-answer.XXXXXX)"
		mount -o ro "$dev" "$point" 2>/dev/null || { rmdir "$point"; continue; }
		if [ -f "$point/byteguru-autoinstall.cfg" ]; then
			# Значения читаются построчно, а не source-ом: файл лежит на
			# fat-разделе, который мог быть создан кем угодно, и исполнять
			# его содержимое как shell нельзя.
			while IFS='=' read -r key value; do
				case "$key" in
					target_disk) CFG_TARGET="$value" ;;
					profile) CFG_PROFILE="$value" ;;
					user) CFG_USER="$value" ;;
					password) CFG_PASSWORD="$value" ;;
					hostname) CFG_HOSTNAME="$value" ;;
				esac
			done < "$point/byteguru-autoinstall.cfg"
			umount "$point" 2>/dev/null
			rmdir "$point"
			return 0
		fi
		umount "$point" 2>/dev/null
		rmdir "$point"
	done
	return 1
}

CMDLINE="$(cat /proc/cmdline)"
BY_CMDLINE=0
case " ${CMDLINE} " in
	*" byteguru.autoinstall "*) BY_CMDLINE=1 ;;
esac

if [ $BY_CMDLINE -eq 0 ] && ! find_answer; then
	# Ни флага, ни файла-ответа: обычный живой пользователь, ничего не трогаем.
	exit 0
fi

for token in ${CMDLINE}; do
	case "${token}" in
		byteguru.target_disk=*) CFG_TARGET="${token#*=}" ;;
	esac
done

# Ждём диск: в госте без KVM он появляется не сразу, а «диска нет» — не
# причина валить тест, если он просто ещё не отсканировался.
wait_for() {
	local node="$1" tries="${2:-120}" i=0
	while [ "$i" -lt "$tries" ]; do
		[ -b "$node" ] && return 0
		sleep 1
		i=$((i + 1))
	done
	return 1
}

if [ -n "$CFG_TARGET" ]; then
	if ! wait_for "$CFG_TARGET"; then
		say "BYTEGURU-INSTALL-FAIL: диск $CFG_TARGET не появился за 120 с"
		exit 1
	fi
else
	for candidate in /dev/sda /dev/vda /dev/nvme0n1; do
		wait_for "$candidate" 10 && { CFG_TARGET="$candidate"; break; }
	done
	[ -n "$CFG_TARGET" ] || { say "BYTEGURU-INSTALL-FAIL: подходящего диска нет"; exit 1; }
fi

# Защита от самого очевидного выстрела в ногу: носитель, с которого мы
# сейчас живые, устанавливать не может.
if findmnt -n -o SOURCE --target /run/live/medium 2>/dev/null | grep -q "^${CFG_TARGET}"; then
	say "BYTEGURU-INSTALL-FAIL: $CFG_TARGET — это live-носитель, а не целевой диск"
	exit 1
fi

say "BYTEGURU-INSTALL: цель $CFG_TARGET (профиль $CFG_PROFILE)"

if ! lsblk -J -b -o NAME,TYPE,SIZE,FSTYPE,LABEL,UUID,MOUNTPOINTS,MODEL,TRAN,PARTTYPENAME \
		> /tmp/byteguru-lsblk.json 2>/dev/null; then
	say "BYTEGURU-INSTALL-FAIL: lsblk не отработал"
	exit 1
fi

# План печатается до исполнения: если планировщик скажет «не могу», это
# должно быть видно в логе, а не тонуть в коде исполнения.
if ! bginstaller plan --disk-file /tmp/byteguru-lsblk.json --device "$CFG_TARGET" \
		--boot uefi --profile "$CFG_PROFILE" > /tmp/byteguru-plan.txt 2>&1; then
	say "BYTEGURU-INSTALL-FAIL: план не собрался"
	tail -12 /tmp/byteguru-plan.txt | while read -r line; do say "  $line"; done
	exit 1
fi

# Пароль тестовой учётной записи. Файл, а не аргумент: в argv он был бы виден
# всему, что работает в этой сессии, включая журнал.
PASSWORD_FILE="$(mktemp)"
printf '%s\n' "$CFG_PASSWORD" > "$PASSWORD_FILE"
chmod 600 "$PASSWORD_FILE"

# Токен подтверждает конкретный план: затирка таблицы — одно слово, изменение
# разметки — другое. Угадывать его по составу действий здесь нечем, поэтому
# спрашиваем у самого планировщика. Пустой ответ — не «ок, пропустим»:
# без токена необратимые шаги были бы молча отменены в середине установки.
CFG_TOKEN="$(bginstaller plan --disk-file /tmp/byteguru-lsblk.json \
	--device "$CFG_TARGET" --boot uefi --profile "$CFG_PROFILE" \
	--print-confirm-token 2>/dev/null | tail -1)"
if [ -z "$CFG_TOKEN" ]; then
	say "BYTEGURU-INSTALL-FAIL: планировщик не назвал токен подтверждения"
	rm -f "$PASSWORD_FILE"
	exit 1
fi

bginstaller apply --disk-file /tmp/byteguru-lsblk.json --device "$CFG_TARGET" \
	--boot uefi --profile "$CFG_PROFILE" --apply --confirm-token "$CFG_TOKEN" \
	--user "$CFG_USER" --password-file "$PASSWORD_FILE" \
	--hostname "$CFG_HOSTNAME" --timezone Europe/Moscow --keyboard ru \
	> /tmp/byteguru-apply.txt 2>&1
code=$?
rm -f "$PASSWORD_FILE"

if [ $code -ne 0 ]; then
	say "BYTEGURU-INSTALL-FAIL: apply вернул $code"
	grep -E '^\[FAIL\]|код [0-9]+|завершилась' /tmp/byteguru-apply.txt | head -8 |
		while read -r line; do say "  $line"; done
	exit 1
fi

say "BYTEGURU-INSTALL-OK: система установлена на $CFG_TARGET"
# Синхронизация обязательна: тест перезапускает QEMU по таймауту, и
# несохранённый squashfs-кэш выглядел бы как «с диска не грузится».
sync
exit 0
