# Линейки решают всё: shell-скрипт и C-код с CRLF не соберутся на Linux-раннере.
* text=auto eol=lf

*.sh text eol=lf
*.bash text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
Makefile text eol=lf
meson.build text eol=lf
*.service text eol=lf
*.slice text eol=lf
*.rules text eol=lf
*.cfg text eol=lf
*.list text eol=lf
*.conf text eol=lf
config text eol=lf
*.key text eol=lf
*.list.chroot text eol=lf
*.hook text eol=lf

*.docx binary
*.iso binary
*.png binary
*.jpg binary
*.jpeg binary
*.svg text
*.ico binary
*.ttf binary
*.woff2 binary
