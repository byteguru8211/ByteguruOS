# ByteguruOS — рабочий стол первого образа.
#
# Выбор: Xfce. Причина утилитарная: Xfce + task-* из Debian даёт предсказуемую
# лёгкую сессию, которая гарантированно стартует в VirtualBox на software-рендере
# (vboxvideo → modesetting) и не требует 3D-ускорения. Plasma/GNOME оставим на
# этап после появления нормального установщика.
#
# Имя подтверждено: task-xfce-desktop 3.81 присутствует в trixie.

task-xfce-desktop

# --- дисплейный менеджер -------------------------------------------------------
# lightdm + gtk-greeter: simplest possible autologin-able стек; sddm/plymouth
# пока не просим.
lightdm
lightdm-gtk-greeter

# --- компоненты рабочего стола --------------------------------------------------
xfce4-terminal
xfce4-whiskermenu-plugin
thunar
thunar-volman
thunar-archive-plugin
mousepad
xfce4-power-manager
xfce4-screenshooter
gnome-disk-utility
# gnome-disk-utility (Disks) — GUI над udisks2; нужен, чтобы пользователь видел,
# что NTFS монтируется только для чтения (политика в etc/udev + etc/udisks2).

# --- сеть/Bluetooth GUI ---------------------------------------------------------
network-manager-gnome
nm-connection-editor
bluez
blueman

# --- утилиты, без которых live-образ выглядит «голым» ---------------------------
xdg-utils
desktop-file-utils
hicolor-icon-theme
policykit-1

# --- TODO-VERIFY (проверить на реальном mirror перед первым релизом) -----------
# fonts-noto-cjk        — широкая типографика; скорее всего есть, но не проверял.
# plymouth              — графический сплэш; с live-boot работает криво, отложили.
# xfonts-cyrillic       — в trixie может быть заменён на fonts-* ; не включаем.
