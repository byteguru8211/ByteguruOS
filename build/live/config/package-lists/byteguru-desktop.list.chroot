# ByteguruOS — рабочий стол.
#
# Это СВОЙ стол: композитор bgwl, оболочка bgpanel/bglauncher/bgsettings,
# локер bglock. Xfce/GNOME в образе нет и быть не должно — иначе пользователь
# получает чужой рабочий стол с наклейкой ByteguruOS, а наш композитор так и
# остаётся неиспробованным бинарником.
#
# Наши .deb лежат в config/packages.chroot/ и ставятся live-build напрямую;
# зависимости отсюда — то, без чего эти пакеты не работают. Имена имён пакетов
# сверены с индексом trixie (см. build/scripts/check-package-names.py).

# --- терминал и файловый менеджер ----------------------------------------------
# foot: Wayland-нативный, лёгкий, без Qt/GTK-зависимостей. Именно его вызывает
# Super+Enter по умолчанию (bgwl.conf), поэтому он обязателен в образе.
foot
foot-terminfo
thunar

# --- то, что оболочка читает руками -------------------------------------------
xdg-utils
desktop-file-utils
hicolor-icon-theme
adwaita-icon-theme
shared-mime-info
gsettings-desktop-schemas
dconf-gsettings-backend
xdg-user-dirs

# --- шрифты: кириллица в UI и в консоли -----------------------------------------
fonts-dejavu-core
fonts-liberation

# --- снимки экрана --------------------------------------------------------------
# Панель и bgwl считают, что захват делает grim (+ slurp для выделения области).
# Протокол screencopy композитор отдаёт, но без клиента «PrtSc» — мёртвая клавиша.
grim
slurp

# --- буфер обмена ---------------------------------------------------------------
wl-clipboard

# --- сессия и права -------------------------------------------------------------
# polkitd + pkexec вместо policykit-1 (в trixie его нет). Нужны установщику для
# привилегированных шагов и fusesync-агенту в live-сессии.
polkitd
pkexec
dbus
dbus-user-session

# --- порталы --------------------------------------------------------------------
# Без portal-бэкенда xdg-desktop-portal не поднимается: отсюда пустые диалоги
# выбора файла у Flatpak-приложений и неработающий захват экрана.
xdg-desktop-portal
xdg-desktop-portal-gtk

# --- звук и питание -------------------------------------------------------------
pipewire
pipewire-pulse
wireplumber
power-profiles-daemon
upower

# --- сеть -----------------------------------------------------------------------
network-manager
iproute2
wireless-tools

# --- приложения из песочницы ----------------------------------------------------
flatpak

# --- уведомления (для проверки bgnote и для сторонних клиентов) ----------------
libnotify-bin

# --- чего здесь СОЗНАТЕЛЬНО нет -------------------------------------------------
# task-xfce-desktop, lightdm, sddm, gnome-shell, plasma-workspace: чужие столы.
# xorg: XWayland появится позже как опция; сам X-сервер в образе не нужен.
# bluez/blueman: Bluetooth отложен до момента, когда у оболочки появится
#   соответствующая панель — сейчас это мёртвая иконка.
# calamares: установщик свой (byteguru-installer), см. docs/ARCHITECTURE.md.
