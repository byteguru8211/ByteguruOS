# grub-pc в live-образе нужен для установки на BIOS-машины: INSTALL.txt с
# самого начала проверяет «UEFI или BIOS/CSM», а i386-pc-модули загрузчика
# даёт именно этот пакет.
#
# Ставим его с install_devices_empty=true: в chroot нет смонтированного ESP и
# нет права лезть в MBR настоящего диска, поэтому postinst должен запускаться
# «вхолостую». Без этой строки сборка ловит либо интерактивный вопрос про
# устройство, либо попытку grub-install, которая в chroot не может удасться.
grub-pc grub-pc/install_devices_empty boolean true
grub-pc grub-pc/install_devices multiselect
grub-pc grub-pc/timeout string 5
