#!/bin/sh
# 0200-byteguru-live-user.chroot — пользователь live-сессии и автологин в стол.
#
# Что должно получиться: ISO загружается без единого вопроса и оказывается в
# сеансе ByteguruOS (bgwl + панель), где можно всё попробовать, включая sudo без
# пароля — это live-демо, а не боевая система.
#
# Почему getty + .bash_profile, а не greetd/lightdm:
#   * greeter — это про «ввести пароль при входе». В live-образе пароля нет, и
#     просить его не у чего;
#   * механизм тривиально читается в логе загрузки и не зависит от того, какой
#     из greeter-пакетов как именно настроен в этой версии Debian;
#   * когда появится настоящий экран входа с паролем, меняется только этот
#     хук — сеанс (bgwl-session) остаётся тем же.
#
# Хук обязан быть исполняемым: live-build молча пропускает не-исполняемые
# файлы в config/hooks/normal/, и тогда образ собирается без пользователя.

set -eu

LIVE_USER="${LIVE_USER:-byteguru}"
LIVE_PASSWORD="${LIVE_PASSWORD:-live}"

echo "[byteguru-hook] пользователь live-сессии: ${LIVE_USER}"

# --- пользователь ---------------------------------------------------------------
if ! getent passwd "$LIVE_USER" >/dev/null 2>&1; then
	useradd --create-home --shell /bin/bash \
		--groups sudo,audio,video,cdrom,floppy,netdev,plugdev "$LIVE_USER"
else
	echo "[byteguru-hook] пользователь уже существует, дополняем группы"
	for group in sudo audio video cdrom floppy netdev plugdev; do
		getent group "$group" >/dev/null 2>&1 && usermod -aG "$group" "$LIVE_USER"
	done
fi

# Пароль задаём и как пароль, и как «live» в /etc/shadow через chpasswd:
# chpasswd читает пару логин:пароль и применяет настроенный метод хеширования,
# поэтому не нужно гадать, yescrypt это в этой системе или sha-512.
echo "${LIVE_USER}:${LIVE_PASSWORD}" | chpasswd

# sudo без пароля — только для live-пользователя и только в live-образе.
# Установщик этот файл не копирует: на установленной системе sudo спрашивает
# пароль (см. src/installer/bginstaller/apply.py).
cat > /etc/sudoers.d/byteguru-live <<EOF
# Автологин-демо: пароль не спрашиваем. Файл живёт только в live-образе.
${LIVE_USER} ALL=(ALL:ALL) NOPASSWD: ALL
EOF
chmod 0440 /etc/sudoers.d/byteguru-live
visudo -cf /etc/sudoers.d/byteguru-live

# --- автологин в сеанс ----------------------------------------------------------
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/50-byteguru-autologin.conf <<EOF
[Service]
# ExecStart= пустой строкой отменяем штатный запуск agetty, затем свой —
# с --autologin. Без пустой строки systemd не заменит, а допишет команду.
ExecStart=
ExecStart=-/sbin/agetty --autologin ${LIVE_USER} --noclear %I \$TERM
EOF

HOME_DIR="$(getent passwd "$LIVE_USER" | cut -d: -f6)"
cat > "$HOME_DIR/.bash_profile" <<'EOF'
# Live-сеанс ByteguruOS: на tty1 сразу поднимаем стол.
#
# Проверка tty обязательна: без неё любой `ssh byteguru@host` или `su -`
# попытался бы запустить композитор из не-консольного шелла, и пользователь
# получил бы вместо оболочки непонятную ошибку про DRM.
if [ "$(id -u)" != "0" ] && [ "$(tty)" = "/dev/tty1" ] && \
   command -v bgwl-session >/dev/null 2>&1; then
	exec bgwl-session
fi
EOF
chown "${LIVE_USER}:${LIVE_USER}" "$HOME_DIR/.bash_profile" "$HOME_DIR/.bashrc" 2>/dev/null || true
chmod 0644 "$HOME_DIR/.bash_profile"

# --- настройки оболочки по умолчанию -------------------------------------------
# Именно этот файл читает bgwl при старте; он же — то, что потом правит
# bgsettings. Держать «первое впечатление» в одном месте важнее, чем экономить
# на одном файле.
mkdir -p "$HOME_DIR/.config/byteguru"
cat > "$HOME_DIR/.config/byteguru/bgwl.conf" <<'EOF'
# ByteguruOS live-демо. Правится из bgsettings или `bgctl set …`.

# Раскладка окон по умолчанию — плавающая: новое окно открывается там, где его
# ожидает человек, пришедший из Windows. Тайл включается одним переключателем
# в панели (или `bgctl set layout tile`).
layout = float
workspaces = 6

workspace = 1:поток 1:#f2a33d
workspace = 2:поток 2:#f2a33d
workspace = 3:код:#4a9eff
workspace = 4:сеть:#3ecf8e
workspace = 5:заметки:#b98cff
workspace = 6:медиа:#ff5c7a

accent-color = #f2a33d
gap-inner = 6
gap-outer = 8
border-width = 2
animations = true
anim-duration = 140
focus-follows-mouse = false

# В демо экран гасим не раньше, чем через 10 минут: иначе локер срабатывает
# посреди демонстрации.
idle-timeout = 600

terminal = foot
file-manager = thunar
xkb-layout = ru,us
EOF
chown -R "${LIVE_USER}:${LIVE_USER}" "$HOME_DIR/.config"

# --- сервисы, которые должны стартовать ---------------------------------------
systemctl enable NetworkManager 2>/dev/null || \
	echo "[byteguru-hook] NetworkManager не включён (нет systemd в chroot?)"

echo "[byteguru-hook] готово: live-пользователь ${LIVE_USER}, автологин на tty1"
