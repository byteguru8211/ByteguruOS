# ByteguruOS — конфигурация ядра x86_64 (defconfig-политика первого релиза)
# ===========================================================================
# Целевая версия: Linux 6.12 LTS (решение проекта — штатный LTS без форка).
# Назначение: десктоп/сервер + тестирование в VirtualBox + задел под будущий
# immutable-root (dm-verity/dm-integrity) и dual boot с Windows (efivarfs, ntfs3).
#
# ФОРМАТ ФАЙЛА
# Это валидный Kconfig-фрагмент: допускаются СТРОКИ ВИДА
#   CONFIG_СИМВОЛ=y|m|n
#   CONFIG_СИМВОЛ="строка"
#   # CONFIG_СИМВОЛ is not set
#   # комментарий
# Никакого пояснительного текста внутри строк CONFIG_ нет намеренно: строка
# вида «CONFIG_X? ПРОВЕРИТЬ» не является валидной, а olddefconfig молча
# проглатывает мусор, и проверка формата теряет смысл.
#
# КАК РЕГЕНЕРИРОВАТЬ / МИНИМИЗИРОВАТЬ
#   1) Распаковать ядро и развернуть наш файл как основу:
#        cp build/configs/kernel.defconfig linux-6.12/.config
#        make -C linux-6.12 ARCH=x86_64 olddefconfig
#      olddefconfig даёт дефолты новым/зависимым символам; символы, которых в
#      этой версии нет, отбрасываются (поэтому список ниже обязан состоять из
#      ПРОВЕРЕННЫХ имён — см. раздел «КАК ПРОВЕРИТЬ СИМВОЛ»).
#   2) Свернуть в canonical defconfig (только отличия от дефолтов):
#        make -C linux-6.12 ARCH=x86_64 savedefconfig
#        cp linux-6.12/defconfig build/configs/kernel.defconfig
#      После этого файл станет короче в 2-3 раза; мы держим развёрнутый вариант
#      сознательно — он читается как документ политики.
#   3) Минимизация под реальное железо (после загрузки в тестовой ВМ):
#        make -C linux-6.12 ARCH=x86_64 localyesconfig   # из lsmod-состояния
#   4) Нашёл/не нашёл символ — проверяем до коммита тремя способами:
#        make -C linux-6.12 ARCH=x86_64 menuconfig          # поиск: /СИМВОЛ/
#        scripts/config --enable СИМВОЛ && make olddefconfig && git diff .config
#        grep -rn "^config СИМВОЛ$" linux-6.12/{arch,drivers,fs,net,block}/
#
# ТРЕБОВАНИЯ К ХОСТУ СБОРКИ
#   gcc make flex bison libssl-dev libelf-dev bc cpio kmod rsync perl
#   И отдельно: pahole (пакет dwarves) — без него падает сборка с
#   CONFIG_DEBUG_INFO_BTF=y. Если pahole недоступен, закомментируйте ровно ту
#   строку, а не весь блок.
#
# ПРАВИЛО ВЫБОРА =y / =m
#   =y   только то, без чего не может произойти загрузка или работа live-образа:
#        EFI/framebuffer, ext4/btrfs/f2fs, squashfs, overlayfs, vfat+iso9660,
#        device-mapper (verity/crypt), loop, AHCI/NVMe, клавиатура/PS-2,
#        крипто для dm-crypt/verity, cgroup/BPF для systemd, KVM-хост, virtio.
#   =m   всё остальное (GPU, Wi-Fi, звук, USB-хосты, кардридеры, ntfs3/exfat,
#        датчики) — как в Debian: модули не раздувают образ и подбираются
#        initramfs/udev под реальное железо.
#   Следствие, о котором надо помнить: если при тестировании ВМ консоль пуста до
#   загрузки модулей — переведите FB_EFI и DRM_VBOXVIDEO в =y (это единственный
#   сценарий, где правило =m стоит нарушить).
#
# ЧЕГО ЗДЕСЬ НЕТ СОЗНАТЕЛЬНО
#   * IPTOKENS — не просим; фильтры остаются на уровне nftables-модулей.
#   * CONFIG_DEBUG_INFO и прочей debug-раздувки: медленнее сборка, больше образ.
#   * Символов, существование которых не подтверждено по Kconfig 6.12: вместо
#     них в конце файла список «НЕ ВКЛЮЧЕНО / ПРОВЕРИТЬ ПОЗЖЕ» — он не ломает
#     сборку и не создаёт ложной уверенности.
#   * A/B и verity-корня как такового: первый образ — обычный installable/live.
#     Модули dm-verity/dm-integrity включены заранее, чтобы смена имиджа не
#     требовала перевыпуска ядра.

# --- архитектура и планировщик --------------------------------------------------
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NUMA=y
CONFIG_NR_CPUS=256
CONFIG_HZ_300=y
CONFIG_HZ=300
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_X86_MCE=y
CONFIG_IA32_EMULATION=y
CONFIG_BINFMT_MISC=y
CONFIG_MMIOWB=y

# --- модули ---------------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# --- EFI / загрузка -------------------------------------------------------------
# EFI stub даёт прямую загрузку vmlinuz прошивкой (путь systemd-boot) и тот же
# fallback \EFI\boot\bootx64.efi, который использует GRUB. efivarfs обязателен
# для efibootmgr, а значит — для byteguru-boot-repair/boot-status из overlay.
CONFIG_EFI=y
CONFIG_EFI_MIXED=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=m
CONFIG_DMI_SYSFS=y
CONFIG_FB=y
CONFIG_FB_EFI=m
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_RANDOM_TRUST_BOOTLOADER=y

# --- инфраструктура, без которой systemd не работает как PID 1 ------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_AUTOFS_FS=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_POSIX_ACL=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_KEYS=y
CONFIG_PERSISTENT_KEYRINGS=y
CONFIG_TRUSTED_KEYS=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- BPF ------------------------------------------------------------------------
# BPF нужен systemd-oomd/ковёркам и будущему WinCompat-трэйсингу.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_INFO_BTF=y

# --- device-mapper: задел под immutable root ------------------------------------
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_DM_INTEGRITY=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_DM_UEVENT=y

# --- блочные устройства ---------------------------------------------------------
CONFIG_BLOCK=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
CONFIG_BLK_DEV_SD=y
CONFIG_CHR_DEV_SG=y
CONFIG_BLK_DEV_SR=y
CONFIG_CDROM=y
CONFIG_SCSI=y
CONFIG_ZRAM=m

# --- SATA/AHCI/NVMe -------------------------------------------------------------
CONFIG_ATA=y
CONFIG_ATA_VERBOSE_ERROR=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_PATA_ATIIXP=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_MULTIPATH=y

# --- файловые системы -----------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
# CONFIG_BTRFS_FS_POSIX_ACL удалён намеренно: в 6.x btrfs перешёл на общий
# FS_POSIX_ACL, который у нас включён ниже (CONFIG_POSIX_ACL=y).
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
CONFIG_FS_ENCRYPTION=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_CACHE=y
CONFIG_SQUASHFS_DECOMP_SINGLE=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y
# ntfs3 — ядерный драйвер NTFS; см. политику «только чтение» в overlay
# (etc/udisks2/mount_options.conf, etc/udev/rules.d/90-...rules).
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XATTR=y
CONFIG_NTFS_FS=m
CONFIG_EXFAT_FS=m
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=m
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_FUSE_FS=m
CONFIG_CUSE=m
CONFIG_QUOTA=y
CONFIG_PRINT_QUOTA_WARNING=y

# --- NLS: кириллица на vfat/exfat (имена файлов из-под Windows) -----------------
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_855=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_KOI8_R=y
CONFIG_NLS_UTF8=y

# --- сон/гибернация (десктоп) ---------------------------------------------------
CONFIG_SWAP=y
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y

# --- сеть -------------------------------------------------------------------------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XTABLES=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_TABLES=m
CONFIG_NF_NAT=m
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_TUN=m
CONFIG_IP_NF_IPTABLES=m

# --- Wi-Fi ------------------------------------------------------------------------
CONFIG_WIRELESS=y
CONFIG_RFKILL=m
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
# mt76: включаем только верхний символ — пер-чиповые варианты в 6.x или
# auto-select, или зависят от точной версии; см. список «ПРОВЕРИТЬ ПОЗЖЕ».
CONFIG_MT76=m
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_RTW88=m
CONFIG_RTW88_PCI=m
CONFIG_RTW88_USB=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_DEBUG=m

# --- Ethernet (базовый набор + гостевые ВМ) --------------------------------------
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_R8169=m
CONFIG_VIRTIO_NET=m

# --- Bluetooth --------------------------------------------------------------------
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_LEDS=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_INTEL=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIVHCI=m

# --- USB ---------------------------------------------------------------------------
CONFIG_USB_SUPPORT=y
CONFIG_USB=m
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_UHCI_HCD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_PRINTER=m
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m

# --- ввод: клавиатура, тачпады, тачскрины -----------------------------------------
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_LOGIPS2PP=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_MOUSE_SYNAPTICS_I2C=m
CONFIG_TOUCHSCREEN_ELAN=m
CONFIG_HID=y
CONFIG_USB_HID=m
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_APPLE=m
CONFIG_HID_LOGITECH=m
CONFIG_I2C=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m

# --- GPU: Intel / AMD / nouveau / VirtualBox / virtio -----------------------------
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=m
CONFIG_DRM_I915=m
CONFIG_DRM_I915_USER_PRIORITY=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=m
CONFIG_DRM_AMDGPU_CIK=m
CONFIG_DRM_AMDGPU_USERPTR=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_NOUVEAU_BACKLIGHT=m
# VirtualBox критичен: владелец образа тестирует именно в нём. vboxvideo даёт
# консоль/графику без Guest Additions.
CONFIG_DRM_VBOXVIDEO=m
CONFIG_DRM_VIRTIO_GPU=m
# nouveau без licensing-блоков: ни CONFIG_NVIDIA_, ни blob-опций не включаем.

# --- виртуализация: хост KVM + гостевые драйверы ----------------------------------
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_VIRT_DRIVERS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_FS=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y
# Гостевая интеграция VirtualBox: канал vboxguest + ФС общих папок vboxsf.
CONFIG_VBOXGUEST=m
CONFIG_VBOXSF_FS=m

# --- звук --------------------------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=1
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF=m
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_ACPI=m
CONFIG_SND_USB_AUDIO=m

# --- ACPI, питание, термо, датчики --------------------------------------------------
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_VIDEO=m
CONFIG_ACPI_AC=m
CONFIG_ACPI_BATTERY=m
CONFIG_BACKLIGHT_CLASS_DEVICE=m
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K8TEMP=m
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS2=y
CONFIG_TCG_CRB=y
CONFIG_X86_MSR=m
CONFIG_X86_CPUID=m
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_MICROCODE=y

# --- кардридеры (ноутбуки) -----------------------------------------------------------
CONFIG_MMC=m
CONFIG_MMC_BLOCK=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_ACPI=m

# --- криптография: нужно dm-crypt/dm-verity/fscrypt ----------------------------------
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_DEFLATE=y

# --- отладка: только то, что полезно пользователю ------------------------------------
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_TIMEOUT=5

# --- НЕ ВКЛЮЧЕНО / ПРОВЕРИТЬ ПОЗЖЕ (имена символов не подтверждены по Kconfig 6.12) --
# CONFIG_MT7915E              Wi-Fi 7/6 PCIe MediaTek (чипы mt7915/mt7921);
# CONFIG_MT7921E              имя существует в 6.x, но зависит от структуры
#                             mt76/Kconfig конкретной версии — включать через
#                             menuconfig после проверки, не «угадывать» сюда.
# CONFIG_SND_SOC_SOF_INTEL_*  машинные SOF-драйверы (tgl/lnl/arl): точные
#                             имена по версии ядра.
# CONFIG_DRM_AMDACO / CONFIG_DRM_SSD  альтернативные AMD-символы, не проверялись.
# CONFIG_NTFS3_FS_POSIX_ACL   возможно существует; не подтверждено — вместо него
#                             достаточно NTFS3_LZX_XATTR.
# CONFIG_NLS_CODEPAGE_1251    cp1251 для vfat: файл nls/1251.c в дереве есть,
#                             имя Kconfig-символа не сверял.
# CONFIG_IIO, CONFIG_SENSORS_...  датчики ноутбуков (0F/sensors) — отложим.
# CONFIG_VFAT_FS default iocharset: CONFIG_FAT_DEFAULT_UTF8 (есть в 6.x) —
#                             добавить после проверки, сейчас держим iocharset=utf8.
# CONFIG_DM_LOG_USERSPACE     thin-check утилитам; не нужен первому образу.
# CONFIG_ZRAM_DEF_COMP_*      выбор алгоритма zram — оставить дефолт.
# CONFIG_BPF_LSM              требуется LSM-строкой CONFIG_LSM; не включаем,
#                             чтобы не менять список LSM у Debian-ядра.
