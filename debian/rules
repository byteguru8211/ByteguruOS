#!/usr/bin/make -f
# Сборка ByteguruOS.
#
# debhelper сам находит meson.build в корне и собирает композитор — раньше
# приходилось притворяться, что buildsystem=none, потому что meson.build в
# репозитории отсутствовал. Python-пакеты раскладываются вручную: четыре
# независимых модуля (bgshell, bgd, bginstaller, wcmgr) «умная» автоматика
# неминуемо свалила бы в один, и тогда opt-out WinCompat стал бы
# невозможным.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
TMP = $(CURDIR)/debian/tmp
PYDIR = $(TMP)/usr/lib/python3/dist-packages

%:
	dh $@

# Тест композитора в meson — это `bgwl --version`: он не открывает бэкенд,
# поэтому проходит и на сборочном контейнере без DRM и без ввода.
override_dh_auto_test:
	dh_auto_test

override_dh_auto_install:
	dh_auto_install
	mkdir -p $(PYDIR) $(TMP)/usr/bin
	cp -a src/shell/bgshell $(PYDIR)/
	cp -a src/bytegurud/bgd $(PYDIR)/
	cp -a src/installer/bginstaller $(PYDIR)/
	cp -a src/wincompat/wcmgr $(PYDIR)/
	cp -a bin/* $(TMP)/usr/bin/
	chmod 0755 $(TMP)/usr/bin/*
	rm -f $(TMP)/usr/bin/*.pyc

	mkdir -p $(TMP)/usr/share/byteguru/wincompat \
		$(TMP)/usr/share/applications \
		$(TMP)/usr/share/wayland-sessions \
		$(TMP)/usr/lib/systemd/user
	cp -a data/wincompat/*.wcv $(TMP)/usr/share/byteguru/wincompat/
	cp -a data/desktop/*.desktop $(TMP)/usr/share/applications/
	cp -a data/wayland-sessions/*.desktop $(TMP)/usr/share/wayland-sessions/
	cp -a data/systemd/user/*.service $(TMP)/usr/lib/systemd/user/

	# Справочные страницы. Копируем, а не dh_installman: страницы живут в
	# docs/man и относятся к разным пакетам, а .man-файлы debhelper только
	# удваивали бы список того, что и так видно по имени. dh_compress
	# сожмёт их сам, на этапе после dh_install.
	mkdir -p $(TMP)/usr/share/man/man1 $(TMP)/usr/share/man/man8
	cp -a docs/man/*.1 $(TMP)/usr/share/man/man1/ 2>/dev/null || true
	cp -a docs/man/*.8 $(TMP)/usr/share/man/man8/ 2>/dev/null || true

override_dh_dwz:
	# dwz на python-пакетах без debug-символов только шумит; выключен явно,
	# чтобы сборка в контейнере не зависела от наличия dwz.
	dh_dwz || true

override_dh_strip:
	# Композитор остаётся с символьной таблицей сознательно: падение в чужой
	# виртуальной машине разбирается по backtrace из журнала сеанса, а
	# вырезанные символы оставляют в стеке одни адреса. Разница в 0,5 МБ на
	# образе в 1,2 ГБ — та цена, за которую «код 139» превращается в имя
	# функции без пересборки образа под конкретного пользователя.
	dh_strip -X usr/bin/bgwl
