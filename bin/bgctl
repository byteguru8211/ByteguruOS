#!/usr/bin/env python3
"""bgctl — управление композитором из терминала.

Существование CLI — не удобство, а следствие дизайна: панель, лаунчер,
настройки и тесты говорят с композитором одним и тем же протоколом. Если
команду можно выполнить здесь, значит оболочка не хранит «секретного» знания,
и ровно так же её набирает человек через `nc -U`.

Примеры:

    bgctl status                 # что открыто, в каком потоке, на каком экране
    bgctl workspace 2            # переключить поток
    bgctl send 0                 # перенести активное окно в поток 1
    bgctl set layout tile        # разложить все потоки тайлом
    bgctl set gap-inner 10
    bgctl lock                   # запустить локер
    bgctl events                 # смотреть, как композитор докладывает изменения
"""

from __future__ import annotations

import argparse
import json
import sys
import time
from pathlib import Path

sys.path[:0] = [str(Path(__file__).resolve().parent.parent / p) for p in
    ("src/shell", "src/bytegurud", "src/installer", "src/wincompat")
    if (Path(__file__).resolve().parent.parent / p).is_dir()]

from bgshell.ctl import Compositor, CompositorError, EventSource, Snapshot  # noqa: E402


def print_state(snapshot: Snapshot, as_json: bool) -> int:
    if as_json:
        print(json.dumps(snapshot.raw, ensure_ascii=False, indent=2))
        return 0

    active = snapshot.active_stream
    print(f"сеанс: {'заблокирован' if snapshot.locked else 'открыт'}"
        f" · панель {'видна' if snapshot.panel_visible else 'скрыта'}")
    for output in snapshot.outputs:
        state = "вкл" if output.enabled else "выкл"
        print(f"экран {output.name}: {output.box[2]}x{output.box[3]}"
            f"+{output.box[0]}+{output.box[1]} · доступно "
            f"{output.usable[2]}x{output.usable[3]} · масштаб {output.scale:g}"
            f" · {state}")
    print("потоки:")
    for stream in snapshot.streams:
        mark = "*" if stream.active else " "
        print(f" {mark} {stream.index}: {stream.name} [{stream.layout}]"
            f" окон {stream.windows} акцент {stream.accent}")
    if active is not None:
        print(f"окна потока {active.index}:")
        for window in snapshot.windows_on(active.index):
            flags = " ".join(filter(None, (
                "фокус" if window.focused else "",
                "тайл" if window.tiled else "",
                "макс" if window.maximized else "",
                "фулл" if window.fullscreen else "",
                "сверху" if window.above else "",
                "липкое" if window.sticky else "",
            )))
            print(f"  #{window.id} {window.app_id or '?'} «{window.title}»"
                f" pid {window.pid} [{flags}] {window.box}")
    return 0


def cmd_status(args) -> int:
    return print_state(Compositor().state(), args.json)


def cmd_command(args) -> int:
    line = " ".join(args.line)
    reply = Compositor().command(line)
    if reply.get("type") == "state":
        return print_state(Snapshot.from_state(reply), args.json)
    print(json.dumps(reply, ensure_ascii=False))
    return 0


def cmd_events(args) -> int:
    """Печатает события, пока не нажмут Ctrl-C.

    Полезно и при отладке оболочки, и при разборе «почему панель не
    перерисовалась»: здесь видно, дошло ли событие вообще.
    """
    def show(kind: str) -> None:
        print(f"EV {kind}", flush=True)

    source = EventSource(show)
    if not source.start():
        print("не удалось подписаться: композитор не отвечает", file=sys.stderr)
        return 1
    print("подписка открыта, Ctrl-C чтобы выйти", file=sys.stderr)
    try:
        while True:
            time.sleep(0.2)
    except KeyboardInterrupt:
        pass
    source.stop()
    return 0


def build_parser() -> argparse.ArgumentParser:
    # --json доступен и до подкоманды, и после неё: `bgctl status --json` —
    # то, что печатают в скриптах, и спорить с argparse об этом незачем.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true",
        help="печатать состояние машиночитаемо")

    parser = argparse.ArgumentParser(prog="bgctl",
        description="управление композитором ByteguruOS", parents=[common])
    sub = parser.add_subparsers(dest="action", required=True)

    sub.add_parser("status", help="снимок сеанса", parents=[common]).set_defaults(
        handler=cmd_status)

    events = sub.add_parser("events", help="печатать события композитора", parents=[common])
    events.set_defaults(handler=cmd_events)

    command = sub.add_parser("command", help="выполнить команду протокола как есть", parents=[common])
    command.add_argument("line", nargs="+")
    command.set_defaults(handler=cmd_command)

    for name, help_text, template in (
        ("workspace", "переключить поток: индекс, next или prev", "workspace {}"),
        ("send", "перенести активное окно в поток", "send {}"),
        ("focus", "сфокусировать окно по id", "focus {}"),
        ("set", "изменить настройку: bgctl set gap-inner 10", "set {}"),
    ):
        child = sub.add_parser(name, parents=[common], help=help_text)
        child.add_argument("argument", nargs="+")
        child.set_defaults(handler=cmd_command, template=template)

    for name, help_text, line in (
        ("close", "закрыть активное окно", "close"),
        ("maximize", "развернуть/свернуть активное окно", "maximize"),
        ("fullscreen", "во весь экран", "fullscreen"),
        ("pin", "прикрепить сверху", "pin"),
        ("reflow", "переложить окна по текущей раскладке", "reflow"),
        ("lock", "запустить локер", "lock"),
        ("quit", "завершить сеанс", "quit"),
    ):
        child = sub.add_parser(name, parents=[common], help=help_text)
        child.set_defaults(handler=lambda _a, line=line: cmd_command(
            _Command(line)))
    return parser


class _Command:
    """Минимальный объект-аргумент для cmd_command без подкоманды."""

    def __init__(self, line: str):
        self.line = [line]
        self.json = False


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    template = getattr(args, "template", None)
    if template and getattr(args, "argument", None):
        args.line = [template.format(" ".join(args.argument))]
    try:
        return args.handler(args)
    except CompositorError as error:
        print(f"bgctl: {error}", file=sys.stderr)
        print("подсказка: композитор должен работать, а сокет — находиться по "
            "$BGWL_CONTROL_SOCKET или $XDG_RUNTIME_DIR/byteguru/compositor.sock",
            file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
