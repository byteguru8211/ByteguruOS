#!/bin/sh
# Точка входа сеанса ByteguruOS (устанавливается как /usr/bin/bgwl-session).
#
# Порядок запуска — не вопрос вкуса:
#
#   1. переменные окружения сеанса: их наследуют и композитор, и все приложения;
#   2. bgd — демон модели приложений; Wayland ему не нужен, и запускать его
#      раньше значит дать панели готовый список к первому кадру;
#   3. bgwl — композитор, в фоне: он создаёт сокет, и без сокета оболочка
#      не может подключиться;
#   4. ждём появления WAYLAND_DISPLAY-сокета (не sleep с потолка: на медленном
#      диске секунды уходят именно сюда);
#   5. оболочка: панель, уведомления, locker-агент;
#   6. ждём композитор. Когда он выходит — сеанс закончен, и всё, что мы
#      подняли, должно уйти вместе с ним.
#
# Компоненты оболочки запускаются отсюда, а не из автозапуска приложений,
# чтобы «сеанс не поднялся» было видно в одном месте и чинилось в одном месте.

set -u

user_id=$(id -u)

# XDG_RUNTIME_DIR обязателен: в нём сокет Wayland, сокет управления композитора
# и сокет bgd. Без него сеанс тоже работает, но панель ничего не видит.
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
	XDG_RUNTIME_DIR="/run/user/$user_id"
	if ! mkdir -p -m 0700 "$XDG_RUNTIME_DIR" 2>/dev/null; then
		XDG_RUNTIME_DIR="/tmp/byteguru-runtime-$user_id"
		mkdir -p -m 0700 "$XDG_RUNTIME_DIR"
	fi
fi
export XDG_RUNTIME_DIR

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=ByteguruOS
export DESKTOP_SESSION=byteguru
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

# Клиентские тулкиты: кто по умолчанию на X11, тот без этой подсказки не
# увидит Wayland. Всё, что не поддержано, молча вернётся к X11 — лучше
# честная совместимость, чем пустой экран.
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export CLUTTER_BACKEND=wayland
export SDL_VIDEODRIVER=wayland
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1
export ADW_DISABLE_PORTAL=0

# Тема композитора читает этот файл; если его нет, bgwl живёт заводскими
# значениями, и это нормальный первый запуск. Без export переменная осталась бы
# локальной для этого шелла, и композитор прочитал бы путь сам.
export BGWL_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/byteguru/bgwl.conf"

# Демоны сеанса. Ошибку запуска не считаем ошибкой сеанса: панель умеет
# работать без bgd (читает .desktop напрямую).
if command -v bgd >/dev/null 2>&1; then
	bgd serve >/dev/null 2>&1 &
	BGD_PID=$!
fi

if ! command -v bgwl >/dev/null 2>&1; then
	echo "bgwl-session: композитор bgwl не установлен" >&2
	exit 127
fi

# Журнал сеанса. Без него падение композитора нечем объяснить: вывод уходит в
# tty, который при автологине никто не листал, а после выхода из сеанса tty
# перезапускается. Файл в $XDG_STATE_HOME читается и живой сессией
# (F2 в консоли), и само-проверкой образа.
SESSION_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/byteguru/session.log"
mkdir -p "$(dirname "$SESSION_LOG")" 2>/dev/null || true
echo "--- bgwl-session: $(date -Is) ---" >> "$SESSION_LOG" 2>/dev/null || true

# Композитор НЕ должен наследовать WAYLAND_DISPLAY. wlroots видит эту
# переменную и выбирает вложенный бэкенд вместо DRM; не сумев подключиться, он
# отдаёт пустой набор бэкендов, и server.c добавляет запасной headless-вывод.
# Наружу это выглядит как зависшая загрузка: сокет создан, панель работает, а
# на мониторе осталась текстовая консоль. Проверено на этом же билде:
# с WAYLAND_DISPLAY — «Creating wayland backend / Could not connect», без него
# бэкенд выбирается по железу.
#
# Явное WLR_BACKENDS отключает защиту: так и задумано, вложенный запуск остаётся
# возможным (скриншоты, отладка внутри сеанса).
if [ -n "${WLR_BACKENDS:-}" ]; then
	bgwl >> "$SESSION_LOG" 2>&1 &
else
	env -u WAYLAND_DISPLAY bgwl >> "$SESSION_LOG" 2>&1 &
fi
BGWL_PID=$!

# Ожидание сокета: 50 шагов по 100 мс. Появление файла — тот же признак, что
# использует клиент Wayland, поэтому проверять больше не на что.
i=0
while [ "$i" -lt 50 ]; do
	[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && break
	kill -0 "$BGWL_PID" 2>/dev/null || {
		echo "bgwl-session: композитор завершился, не создав сокет" >&2
		# Причина в журнале сеанса: без этих строк «экран не поднялся»
		# разбирается гаданием, потому что tty после выхода перезапускается.
		tail -n 8 "$SESSION_LOG" 2>/dev/null | while read -r line; do
			echo "  $line" >&2
		done
		wait "$BGWL_PID"
		exit 1
	}
	i=$((i + 1))
	sleep 0.1
done

if [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
	echo "bgwl-session: сокета нет через 5 с, процесс композитора жив: $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" >&2
	tail -n 8 "$SESSION_LOG" 2>/dev/null | while read -r line; do
		echo "  $line" >&2
	done
fi

# Экран. Без KMS-устройства композитор уходит на запасной headless-вывод: сокет
# есть, всё отвечает, а на мониторе остаётся текстовая консоль — человек видит
# это как «загрузка зависла». Различить можно только по ответу самого
# композитора, поэтому спрашиваем его, а не гадаем по /dev/dri.
if command -v bgctl >/dev/null 2>&1; then
	screen_seen=0
	i=0
	# Сколько ждать экран — считанные секунды на нормальном железе: вывод
	# появляется вместе с DRM-бэкендом. Переменная нужна медленным машинам и
	# проверке этого скрипта в тестах.
	tries="${BGWL_SESSION_SCREEN_TRIES:-30}"
	while [ "$i" -lt "$tries" ]; do
		if bgctl --json status 2>/dev/null | grep -q '"headless": *false'; then
			screen_seen=1
			break
		fi
		kill -0 "$BGWL_PID" 2>/dev/null || break
		i=$((i + 1))
		sleep 1
	done
	# Предупреждение имеет смысл, пока композитор жив: мёртвый процесс
	# объяснит себя ниже, где сеанс ждёт его код возврата.
	if [ "$screen_seen" -eq 0 ] && kill -0 "$BGWL_PID" 2>/dev/null; then
		{
			echo "bgwl-session: композитор работает, но ни одного экрана не увидел."
			echo "bgwl-session: на мониторе останется текстовая консоль — это не зависание:"
			echo "bgwl-session: сеанс живёт на запасном headless-выводе."
			echo "bgwl-session: в виртуальной машине нужен видеоадаптер VMSVGA (не VBoxSVGA/VGA),"
			echo "bgwl-session: на машине — /dev/dri/card0, то есть драйвер GPU в ядре."
		} >&2
		echo "bgwl-session: экранов нет, вывод только headless" >> "$SESSION_LOG" 2>/dev/null || true
	fi
fi

# Оболочка. Каждое окно — отдельный процесс: падение панели не должно
# утаскивать за собой сеанс.
shell_pids=""
for component in bgpanel bgnote; do
	if command -v "$component" >/dev/null 2>&1; then
		"$component" >> "$SESSION_LOG" 2>&1 &
		shell_pids="$shell_pids $!"
	fi
done

# Единая точка выхода: композитор умер — гасим всё, что подняли.
wait "$BGWL_PID"
status=$?
for pid in $shell_pids ${BGD_PID:-}; do
	kill "$pid" 2>/dev/null
done
exit "$status"
