[wcv]
schema = 1
id = "notepad-plus"
name = "Notepad++"
version = "8.6.8"
publisher = "Notepad++ Community"
executable = "notepad++.exe"
runner = "wine"
expected_level = "l1"
wine = "9.0"
tested = false
comments = "Пример манифеста. Уровень заявлен автором и ещё не подтверждён прогоном на сборке ByteguruOS."

[graph]
path = "auto"

[drives]
mappings = [
  { letter = "C", kind = "prefix", mode = "rw" },
  { letter = "Z", kind = "bind", path = "/home/%USER%/Документы", mode = "rw" },
]

[filesystem]
visible = ["/home/%USER%/Документы"]

[security]
apparmor = "enforce"
seccomp = "strict"

[integration]
menu = true
mime = ["text/plain", "source/code"]
