__pycache__/
*.py[cod]
*.egg-info/
build/.venv/
.venv/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Локальные артефакты сборки образа и rootfs — никогда не попадают в git
output/
build/.debwork/
build/.debtmp/
iso-build/
chroot/
*.iso
*.iso.sha256
*.pkg.tar.zst
*.deb
*.rpm

# Рабочие данные подсистем при локальных прогонах
.var/
var/
*.wcv.cache/

# Редакторы и ОС
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Локальные рабочие каталоги сборки композитора
build-c/
build-wl/

# Выход dpkg-buildpackage и debhelper: пересоздаются на каждой сборке пакетов.
# Держать их в git — это две копии одного дерева и шум в diff, в котором
# теряется настоящая правка (в частности debian/*.install).
debian/tmp/
debian/.debhelper/
debian/byteguru-*/
debian/*.substvars
debian/*.deb
debian/*.buildinfo
debian/*.changes

# Кэш индексов apt, которым check-package-names.py сверяет имена пакетов.
# 13 МБ на клон — это не данные проекта, а скачанный из архива отчёт.
.cache/
